<script>

/* ============================================================
   SIMPLE PAGE NAVIGATION
============================================================ */

function openPage(pageName) {

    var pages = document.querySelectorAll(".page");

    for (var i = 0; i < pages.length; i++) {

        pages[i].classList.remove("active");

    }


    var buttons =
        document.querySelectorAll("nav button");

    for (var j = 0; j < buttons.length; j++) {

        buttons[j].classList.remove("active");

    }


    var selectedPage =
        document.getElementById(pageName);

    if (selectedPage) {

        selectedPage.classList.add("active");

    }


    var selectedButton =
        document.querySelector(
            'nav button[data-page="' +
            pageName +
            '"]'
        );

    if (selectedButton) {

        selectedButton.classList.add("active");

    }


    window.scrollTo(0, 0);

}


/* Navigation buttons */

var navigationButtons =
    document.querySelectorAll("nav button");

for (var i = 0; i < navigationButtons.length; i++) {

    navigationButtons[i].addEventListener(
        "click",
        function() {

            openPage(this.getAttribute("data-page"));

        }
    );

}


/* Dashboard cards and links */

var pageLinks =
    document.querySelectorAll("[data-page-link]");

for (var k = 0; k < pageLinks.length; k++) {

    pageLinks[k].addEventListener(
        "click",
        function() {

            openPage(
                this.getAttribute("data-page-link")
            );

        }
    );

}


/* ============================================================
   SEARCH
============================================================ */

function addSearch(inputId, rowsId) {

    var input =
        document.getElementById(inputId);

    var rows =
        document.getElementById(rowsId);

    if (!input || !rows) {
        return;
    }


    input.addEventListener(
        "input",
        function() {

            var query =
                input.value.toLowerCase().trim();

            var tableRows =
                rows.querySelectorAll("tr");


            for (var i = 0; i < tableRows.length; i++) {

                var text =
                    tableRows[i]
                    .textContent
                    .toLowerCase();

                if (text.indexOf(query) !== -1) {

                    tableRows[i].style.display = "";

                } else {

                    tableRows[i].style.display = "none";

                }

            }

        }
    );

}


addSearch(
    "mineSearch",
    "mineRows"
);


addSearch(
    "projectSearch",
    "projectRows"
);


addSearch(
    "permitSearch",
    "permitRows"
);


/* ============================================================
   START
============================================================ */

openPage("home");

</script>


</body>
</html>
